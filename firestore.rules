rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Preserve the coffee app's existing private collection.
    match /users/{userId}/brews/{brewId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/homeKitchen/{documentId} {
      allow read: if request.auth != null && request.auth.uid == userId && documentId == 'state';
      allow create, update: if request.auth != null && request.auth.uid == userId
        && documentId == 'state'
        && request.resource.data.keys().hasOnly(['data', 'revision', 'token', 'updatedAt'])
        && request.resource.data.data is map
        && request.resource.data.data.version == 1
        && request.resource.data.revision is int
        && request.resource.data.token is string
        && request.resource.data.updatedAt == request.time
        && ((!exists(/databases/$(database)/documents/users/$(userId)/homeKitchen/state)
             && request.resource.data.revision == 1)
          || (exists(/databases/$(database)/documents/users/$(userId)/homeKitchen/state)
             && request.resource.data.revision == resource.data.revision + 1));
    }
  }
}
